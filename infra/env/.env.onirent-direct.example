# ONIRENT 公网直连（推荐：Alioth 跑在能直连 ADB 的负责人本机）
# 同事只开 Alioth 网页交任务；不要发 SSH 金钥／root 密码，不要让同事自己 adb。
#
# 代码契约：ALIOTH_ONIRENT_ADB_SOURCE=direct
#   → services/api/.../onirent_adb_tunnel.py::list_onirent_public_adb_endpoints
#   → cloud_phone_vendor.list_pool_onirent_adb_endpoints

ALIOTH_DEVICE_BACKEND=cloud_phone
ALIOTH_CLOUD_PHONE_VENDOR=onirent
ALIOTH_ONIRENT_ADB_SOURCE=direct
ALIOTH_ONIRENT_ADB_TUNNEL=0

# 当前实验室两台（可按需增删；须与 SLOTS 等长）
ALIOTH_DEVICE_POOL_SLOTS=cloud_phone:qa-a,cloud_phone:qa-b
ALIOTH_DEVICE_POOL_ONIRENT_ADB=51.89.164.208:20615,51.195.137.27:20660
ALIOTH_CLOUD_PHONE_ADB=51.89.164.208:20615
ALIOTH_CLOUD_PHONE_ADB_AUTH=

# 若清空 DEVICE_POOL_ONIRENT_ADB，将回退代码默认四台公网：
#   51.89.164.208:20615,51.89.164.208:20613,51.195.137.27:20033,198.244.190.180:20907

ALIOTH_CLOUD_PHONE_MORELOGIN_API=adb
ALIOTH_MORELOGIN_ADB_AUTO_POWER_ON=0
ALIOTH_MORELOGIN_ADB_AUTO_REFRESH=0
ALIOTH_MORELOGIN_ADB_AUTO_ENABLE=0
ALIOTH_MORELOGIN_ADB_AUTO_POWER_OFF=0
ALIOTH_DEVICE_POOL_MORELOGIN_ENV_IDS=
ALIOTH_MORELOGIN_CLOUDPHONE_ID=

# 可选：仍保留 CC 智控 WS（direct 模式下不依赖）
ALIOTH_ONIRENT_WS_URL=ws://127.0.0.1:33332/
