# 主站連遠端模擬器沙盒（主站跑 API+DB，沙盒只跑 ReDroid+Mobile Host）
# 用法：复制为 .env.local 片段，或 merge 进主站 env
#
# 沙盒機先起：
#   bash scripts/start-emulator-sandbox.sh
# 主站驗證：
#   SANDBOX_HOST=<ip> bash scripts/verify-cross-server-emulator.sh

ALIOTH_DEVICE_BACKEND=redroid
# 指向沙盒 Mobile Host 公網/內網 IP
ALIOTH_MOBILE_DEMO_HOST_EXECUTOR=http://192.168.33.128:8765
# 跨伺服器時自動 sync APK/run；也可顯式 1
ALIOTH_MOBILE_DEMO_REMOTE_SYNC=1
ALIOTH_WORKSPACE_HOST=/workspace

# 主站不直接連 ReDroid；由沙盒 mobile-host 執行
# ALIOTH_REDROID_ADB 留空或勿指向本機

# 必须与沙盒 Host Runner 使用相同的高强度 token
ALIOTH_MOBILE_DEMO_HOST_TOKEN=change-me-sandbox
