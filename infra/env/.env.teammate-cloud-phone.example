# 同事本机 Alioth 共用星语侧 ONIRENT 云手机（须本机开着 ONIRENT／CC智控客户端，或使用下方固定 ADB）。
# 复制下面整段进本机 infra/env/.env.local，然后重建／重启 API／Worker。
# 注意：每人本机 PostgreSQL 租约互不感知，多机并发会互抢；先口头错开 qa-a／qa-b。
#
# ONIRENT ADB Shell 可见公网端点示例（与控制台【2】【3】一致，按实机改）：
#   51.89.167.239:20195 / 51.195.137.27:20086
# CC智控 WS：ws://127.0.0.1:33332/  {"type":"list"} → data=["host:port",...]

ALIOTH_DEVICE_BACKEND=cloud_phone
ALIOTH_CLOUD_PHONE_VENDOR=onirent
ALIOTH_ONIRENT_ADB_SOURCE=auto
ALIOTH_ONIRENT_WS_URL=ws://127.0.0.1:33332/
ALIOTH_APP_DEVICE_LEASE_BACKEND=postgres
ALIOTH_DEVICE_POOL_SLOTS=cloud_phone:qa-a,cloud_phone:qa-b
ALIOTH_DEVICE_POOL_ONIRENT_ADB=51.89.167.239:20195,51.195.137.27:20086
ALIOTH_CLOUD_PHONE_ADB=51.89.167.239:20195
ALIOTH_CLOUD_PHONE_ADB_AUTH=
ALIOTH_CLOUD_PHONE_MORELOGIN_API=adb
ALIOTH_DEVICE_WAIT_MAX_SECONDS=600
# ONIRENT 无 MoreLogin power／enableAdb API
ALIOTH_MORELOGIN_ADB_AUTO_REFRESH=0
ALIOTH_MORELOGIN_ADB_AUTO_ENABLE=0
ALIOTH_MORELOGIN_ADB_AUTO_POWER_ON=0
ALIOTH_MORELOGIN_ADB_AUTO_POWER_OFF=0
ALIOTH_DEVICE_POOL_MORELOGIN_ENV_IDS=
ALIOTH_MORELOGIN_CLOUDPHONE_ID=
ALIOTH_MORELOGIN_API_ID=
ALIOTH_MORELOGIN_API_KEY=
