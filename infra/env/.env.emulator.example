# Docker Android 模擬器整合（青云客方向 / ReDroid overlay）
# 用法：复制为 .env.emulator.local 后
#   cd infra && docker compose --env-file env/.env.emulator.local \
#     -f docker-compose.yml -f docker-compose.emulator.yml --profile emulator up -d
#
# 可选第二台：追加 --profile emulator-multi
# 可选 Appium：追加 --profile appium

ALIOTH_ENV_FILE=./env/.env.local
ALIOTH_DEVICE_BACKEND=redroid
ALIOTH_MOBILE_DEMO_HOST_EXECUTOR=http://alioth-mobile-host:8765
ALIOTH_REDROID_ADB=127.0.0.1:5555
# Linux Docker 內 API／Mobile Host 共用掛載（勿填 F:/...）
ALIOTH_WORKSPACE_HOST=/workspace

# ReDroid 容器 1
ALIOTH_REDROID_PORT=5555
ALIOTH_REDROID_WIDTH=1080
ALIOTH_REDROID_HEIGHT=1920
ALIOTH_REDROID_DPI=320
ALIOTH_REDROID_GPU_MODE=guest
# ALIOTH_REDROID_IMAGE=redroid/redroid:12.0.0_64only-latest

# ReDroid 容器 2（--profile emulator-multi）
ALIOTH_REDROID_2_PORT=5556

# Mobile Host Runner（adb + airtest）
ALIOTH_MOBILE_HOST_PORT=8765
ALIOTH_MOBILE_HOST_BIND=127.0.0.1
ALIOTH_MOBILE_DEMO_HOST_TOKEN=change-me-local

# Appium 預留（--profile appium）
ALIOTH_APPIUM_PORT=4723
# ALIOTH_APPIUM_IMAGE=appium/appium:latest
