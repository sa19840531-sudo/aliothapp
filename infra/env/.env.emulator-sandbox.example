# 模擬器沙盒專用（獨立 Linux 伺服器）
# 用法（在仓库根目录执行）：
#   ALIOTH_EMULATOR_ENV_FILE=infra/env/.env.emulator-sandbox.example \
#     bash scripts/start-emulator-sandbox.sh

ALIOTH_DEVICE_BACKEND=redroid
ALIOTH_REDROID_ADB=alioth-redroid:5555
ALIOTH_MOBILE_DEMO_FORCE_LOCAL=1
ALIOTH_MOBILE_DEMO_DATA_DIR=/workspace/.alioth-mobile-demo
ALIOTH_WORKSPACE_HOST=/workspace

ALIOTH_REDROID_PORT=5555
ALIOTH_REDROID_WIDTH=1080
ALIOTH_REDROID_HEIGHT=1920
ALIOTH_REDROID_DPI=320
ALIOTH_REDROID_GPU_MODE=guest

ALIOTH_MOBILE_HOST_PORT=8765
# 沙盒跨服务器发布时必须明确绑定地址；只有在防火墙已限制来源时才使用 0.0.0.0
ALIOTH_MOBILE_HOST_BIND=0.0.0.0
# 主站与沙盒必须配置相同的高强度 token
ALIOTH_MOBILE_DEMO_HOST_TOKEN=change-me-sandbox
