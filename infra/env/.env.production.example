# Alioth 应用生产环境变量模板。复制到服务器独立配置目录后填入真实值，禁止提交凭证。
ALIOTH_APP_NAME=Alioth API
ALIOTH_ENVIRONMENT=production
ALIOTH_API_V1_PREFIX=/api/v1
ALIOTH_DEBUG=false
# 仅填入部署平台注入的随机强密钥，至少 32 字节；下方示例值会被启动门禁拒绝。
ALIOTH_AUTH_SECRET=replace-with-at-least-32-random-characters
ALIOTH_CORS_ALLOWED_ORIGINS=http://replace-with-deployment-host

# 外部 PostgreSQL、Redis 通过 Docker 外部网络访问。密码中的特殊字符必须进行 URL 编码。
ALIOTH_DATABASE_URL=postgresql://alioth:replace-with-url-encoded-password@postgres:5432/alioth
ALIOTH_REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379/0
# 本地环境还包含以下数据库容器初始化项；生产应用复用外部数据库，不读取这些项。
# 仅在单独部署 PostgreSQL 容器时填入其配置，不替代上面的应用连接串。
# POSTGRES_DB=alioth
# POSTGRES_USER=alioth
# POSTGRES_PASSWORD=replace-with-database-password
ALIOTH_QUEUE_RUN_TTL_SECONDS=86400
ALIOTH_AGENT_RUN_QUEUE_KEY=alioth:agent-runs:queue
ALIOTH_WEB_AGENT_RUN_QUEUE_KEY=alioth:agent-runs:web-v2
ALIOTH_AGENT_RUN_STATE_STORE_BACKEND=postgres
ALIOTH_WORKFLOW_VERSION=v2
ALIOTH_H5_V2_MODE=on
# Web 探索独立门禁：off | exploration_only | on；首期生产默认关闭。
ALIOTH_WEB_V2_MODE=off
# Web 成年自我声明：由实际部署责任方填写，禁止复制开发机声明身份和时间。
# 启用时须填写声明人和带时区的 ISO 8601 时间，例：2026-09-21T12:00:00+08:00。
ALIOTH_WEB_ADULT_SELF_ATTESTATION_ENABLED=true
ALIOTH_WEB_ADULT_SELF_ATTESTATION_VERSION=adult-v1
ALIOTH_WEB_ADULT_SELF_ATTESTATION_DECLARED_BY=
ALIOTH_WEB_ADULT_SELF_ATTESTATION_DECLARED_AT=
ALIOTH_H5_INSPECTION_NOTIFICATION_MODE=enforced
# H5 逻辑界面与目标默认关闭；正式 Web Runtime 显式关闭这三个开关，不受此处影响。
ALIOTH_H5_LOGICAL_SURFACE_ENABLED=false
ALIOTH_H5_LOGICAL_SURFACE_SHADOW=false
ALIOTH_H5_LOGICAL_TARGETS_ENABLED=false
# H5 视觉坐标导航默认关闭；需按 off → shadow → enforced 分阶段放量。
ALIOTH_H5_VISUAL_COORDINATE_MODE=off
# 默认直连；只有部署网络明确要求代理时才填写，禁止在 URL 中嵌入凭据。
ALIOTH_H5_BROWSER_PROXY_SERVER=
ALIOTH_H5_BROWSER_PROXY_BYPASS=
# H5 自动登录默认关闭。启用时必须把只读 JSON 同时挂载到 API 与 Worker，
# 且该路径必须填写容器内路径，禁止把账号密码直接写入 dotenv。
ALIOTH_H5_AUTH_ENABLED=false
ALIOTH_H5_AUTH_CONFIG_PATH=
# Web V2 桌面 Chromium 出网代理；与 H5 独立，默认留空保持直连。
ALIOTH_WEB_BROWSER_PROXY_SERVER=
ALIOTH_WEB_BROWSER_PROXY_BYPASS=

# 若同一 Worker 承载已开启的 Web V2，改为 explorer,web_explorer,judge。
# 专用 Web Worker 的角色仍由部署编排单独覆盖，不因本机设置改变生产角色。
ALIOTH_WORKER_ROLES=explorer,judge
# App/H5 共用默认 FIFO 队列；此值是单进程同时消费 Run 的执行槽数，设为 1 会串行排队。
# App 并发还受实际可用设备租约限制；调整前须核对云机库存、模型额度及浏览器内存。
ALIOTH_WORKER_CONCURRENCY=3
# Web 使用独立 FIFO 队列和消费者；同进程仍受下方共享总许可限制。
# 专用 Web 容器仅启用 web_explorer，其总许可独立计算，扩容须核对整机容量。
ALIOTH_WEB_WORKER_CONCURRENCY=2
# App/H5/Web 在一个进程共享此总许可；等待许可时消息仍留在 Redis 排队。
ALIOTH_WORKER_MAX_ACTIVE_RUNS=4
# Main 终态后至少等待十分钟；只有全类工作和资源均停止才审计结束异常收口。
ALIOTH_FINALIZATION_STALL_TIMEOUT_SECONDS=600
ALIOTH_WORKER_POLL_TIMEOUT_SECONDS=5
ALIOTH_APP_RUN_LEASE_SECONDS=180
ALIOTH_APP_RUN_RECOVERY_INTERVAL_SECONDS=5
# App 质检装置面：生产正式路径为云手机（容器镜像已含 adb）。
ALIOTH_DEVICE_BACKEND=cloud_phone
ALIOTH_APP_QC_ENABLED=true
ALIOTH_APP_RUNTIME_PROVIDER=official
# App 设备租约：生产必须 postgres；槽位按实际云手机登记，禁止空库存开机安装。
ALIOTH_APP_DEVICE_LEASE_BACKEND=postgres
# ONIRENT：服务器推荐走 Linode 跳板（SOURCE=tunnel）；直连公网时改 SOURCE=direct 并改 ADB 列表。
# 完整跳板样例见 infra/env/.env.linode-shared-tunnel.example 与
# docs/deployment/2026-09-17-cloud-phone-deployment-plan.md §服务器部署。
ALIOTH_CLOUD_PHONE_VENDOR=onirent
ALIOTH_ONIRENT_ADB_SOURCE=tunnel
ALIOTH_ONIRENT_ADB_TUNNEL=1
ALIOTH_ONIRENT_ADB_TUNNEL_JUMP_HOST=172.104.172.119
ALIOTH_ONIRENT_ADB_TUNNEL_BIND=0.0.0.0
ALIOTH_ONIRENT_ADB_TUNNEL_MAP=51.89.164.208:20615=172.104.172.119:30615,51.195.137.27:20660=172.104.172.119:30660,198.244.190.180:20907=172.104.172.119:30907,51.195.137.27:20033=172.104.172.119:30033,51.89.164.208:20613=172.104.172.119:30613
# 服务器容器内不要依赖本机 CC 智控 WS；留空或保留也不应作为唯一选机源。
ALIOTH_ONIRENT_WS_URL=
ALIOTH_DEVICE_POOL_SLOTS=cloud_phone:qa-a,cloud_phone:qa-b,cloud_phone:qa-c,cloud_phone:qa-d,cloud_phone:qa-e
ALIOTH_DEVICE_POOL_ONIRENT_ADB=172.104.172.119:30615,172.104.172.119:30660,172.104.172.119:30907,172.104.172.119:30033,172.104.172.119:30613
ALIOTH_CLOUD_PHONE_ADB=172.104.172.119:30615
ALIOTH_CLOUD_PHONE_ADB_AUTH=
ALIOTH_CLOUD_PHONE_MORELOGIN_API=adb
# 生产默认 off。Lab 对账勿开生产 AUTHORITY；生产开闸用 ALIOTH_APP_MILESTONE_AUTHORITY_M4…
ALIOTH_APP_LAB_MILESTONE=off
# 刀 B：关闭前排空／Probe；仅 Lab M6/M7 可开，生产默认 false
ALIOTH_APP_LAB_EXECUTES_PROBE=false
# MoreLogin 已停用：保持空
ALIOTH_DEVICE_POOL_MORELOGIN_ENV_IDS=
# 池满有界等待上限（秒）；超过后 DEVICE_WAIT_TIMEOUT，不开机安装。
ALIOTH_DEVICE_WAIT_MAX_SECONDS=600
ALIOTH_MORELOGIN_CLOUDPHONE_ID=
ALIOTH_MORELOGIN_API_MODE=local
ALIOTH_MORELOGIN_OPEN_API=
ALIOTH_MORELOGIN_API_ID=
ALIOTH_MORELOGIN_API_KEY=
ALIOTH_MORELOGIN_LOCAL_API=
ALIOTH_MORELOGIN_ADB_AUTO_REFRESH=0
ALIOTH_MORELOGIN_ADB_AUTO_ENABLE=0
ALIOTH_MORELOGIN_ADB_AUTO_POWER_ON=0
ALIOTH_MORELOGIN_ADB_AUTO_POWER_OFF=0
ALIOTH_DEVICE_LEASE_RECOVERY_INTERVAL_SECONDS=5
ALIOTH_DEVICE_LEASE_RECOVERY_GRACE_SECONDS=60

# 生产流量必须等待 PG、Redis、证据存储和至少一个新鲜 Worker 心跳全部通过。
ALIOTH_READINESS_REQUIRE_WORKER_HEARTBEAT=true
ALIOTH_READINESS_WORKER_HEARTBEAT_MAX_AGE_SECONDS=30

ALIOTH_AGENT_MAX_STEPS=200
ALIOTH_AGENT_MAX_ITERATIONS=200
ALIOTH_AGENT_MAX_DURATION_SECONDS=3600
ALIOTH_AGENT_MAX_STEPS_HARD_CAP=600
ALIOTH_AGENT_STUCK_WINDOW=3
ALIOTH_AGENT_RETRY_MAX_ATTEMPTS=3
ALIOTH_AGENT_RETRY_BACKOFF_SECONDS=0.5

ALIOTH_LLM_PROVIDER=custom
ALIOTH_LLM_API_STYLE=chat_completion
ALIOTH_LLM_MODEL=gpt-5.6-terra
ALIOTH_LLM_REASONING_EFFORT=low
ALIOTH_LLM_API_KEY=replace-with-secret
ALIOTH_LLM_BASE_URL=https://api.routin.ai/v1
ALIOTH_LLM_TIMEOUT_SECONDS=180
ALIOTH_LLM_MAX_RETRIES=2
ALIOTH_LLM_USAGE_AUDIT_ENABLED=1
ALIOTH_LLM_COST_CURRENCY=CNY
ALIOTH_LLM_INPUT_PRICE_PER_MILLION_TOKENS=0.8
ALIOTH_LLM_OUTPUT_PRICE_PER_MILLION_TOKENS=2.4
ALIOTH_LLM_CACHE_HIT_PRICE_PER_MILLION_TOKENS=0.2
ALIOTH_LLM_LONG_CONTEXT_THRESHOLD_TOKENS=200000
ALIOTH_LLM_LONG_CONTEXT_INPUT_PRICE_PER_MILLION_TOKENS=1.6
ALIOTH_LLM_LONG_CONTEXT_OUTPUT_PRICE_PER_MILLION_TOKENS=4.8
ALIOTH_LLM_LONG_CONTEXT_CACHE_HIT_PRICE_PER_MILLION_TOKENS=0.4

ALIOTH_QC_SEMANTIC_REQUEST_TIMEOUT_SECONDS=60
ALIOTH_QC_SEMANTIC_MAX_RETRIES=0
ALIOTH_QC_SEMANTIC_CIRCUIT_SECONDS=120
ALIOTH_QC_WEB_INTERACTION_TIMEOUT_SECONDS=120

# 持久化质检工作项必须按 off -> shadow -> on 独立放量。
ALIOTH_QC_INSPECTION_LEASE_SECONDS=180
ALIOTH_QC_INSPECTION_MAX_ATTEMPTS=3
ALIOTH_QC_INSPECTION_RETRY_BASE_SECONDS=2
ALIOTH_SUPPLEMENTAL_EVIDENCE_ENABLED=false

ALIOTH_EVIDENCE_STORAGE_BACKEND=minio
ALIOTH_MINIO_ENDPOINT=minio:9000
ALIOTH_MINIO_ACCESS_KEY=replace-with-access-key
ALIOTH_MINIO_SECRET_KEY=replace-with-secret-key
ALIOTH_MINIO_BUCKET=alioth
ALIOTH_MINIO_SECURE=false

# 证据清单读取（E24）：off=旧读取；shadow=双读对账；on=清单权威（需持久化零差异凭证）。
ALIOTH_EVIDENCE_MANIFEST_READ_MODE=off
# 可选 ISO 时间；早于该时点的历史采集按分流走旧读取。例：2026-08-01T00:00:00+00:00
# ALIOTH_EVIDENCE_MANIFEST_CUTOVER_AT=
ALIOTH_EVIDENCE_MANIFEST_MIN_COMPARED_CAPTURES=1

# Web/H5 离场门禁（E16）：off / shadow / on；切 on 前须确认清单与需求集已产出。
ALIOTH_WEB_EVIDENCE_EXIT_GATE_MODE=off
ALIOTH_WEB_EVIDENCE_EXIT_RESERVATION_SECONDS=120
ALIOTH_WEB_EVIDENCE_EXIT_SWEEP_INTERVAL_SECONDS=60
ALIOTH_WEB_EVIDENCE_EXIT_SWEEP_LIMIT=100

# 证据生命周期：默认只评估、不物理删除；legal hold 期间禁止 GC。
ALIOTH_EVIDENCE_LIFECYCLE_POLICY_VERSION=evidence-lifecycle.v1
ALIOTH_EVIDENCE_RETENTION_DAYS=90
ALIOTH_EVIDENCE_GC_ENABLED=false
ALIOTH_EVIDENCE_GC_BATCH_LIMIT=100
ALIOTH_EVIDENCE_LIFECYCLE_SWEEP_INTERVAL_SECONDS=300

PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# 本地历史调试项：当前已提交代码无读取入口，生产不启用；仅为迁移配置时辨识遗留键。
# ALIOTH_DEBUG_RUN_WITH_TASK_ALLOW_SENSITIVE=false
