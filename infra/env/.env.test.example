ALIOTH_ENV_FILE=./env/.env.test.example
ALIOTH_ENVIRONMENT=test
ALIOTH_DEBUG=false
ALIOTH_API_V1_PREFIX=/api/v1

ALIOTH_API_PORT=18000
ALIOTH_WEB_PORT=15173
ALIOTH_DEVUI_PORT=18080
ALIOTH_POSTGRES_PORT=15432
ALIOTH_REDIS_PORT=16379
ALIOTH_WEB_APP_DIR=app/workstation

POSTGRES_DB=alioth_test
POSTGRES_USER=alioth_test
POSTGRES_PASSWORD=replace-with-test-password

ALIOTH_DATABASE_URL=postgresql+asyncpg://alioth_test:replace-with-test-password@alioth-postgres:5432/alioth_test
ALIOTH_REDIS_URL=redis://alioth-redis:6379/1
VITE_API_BASE_URL=http://localhost:18000/api/v1

ALIOTH_DEVUI_API_BASE_URL=http://alioth-api:8000/api/v1
DEVUI_AUTH_TOKEN=replace-with-test-devui-token

ALIOTH_QC_INSPECTION_LEASE_SECONDS=180
ALIOTH_QC_INSPECTION_MAX_ATTEMPTS=3
ALIOTH_QC_INSPECTION_RETRY_BASE_SECONDS=2
