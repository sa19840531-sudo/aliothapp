# 雲手機 + AI POC 環境片段
# 合併進 infra/env/.env.local 後使用：
#   powershell -File scripts/start-mobile-demo-cloud-phone.ps1
#
# 雲手機供應商：onirent（CC智控 WS／固定 ADB）或 morelogin（Open API）
ALIOTH_CLOUD_PHONE_VENDOR=onirent
# CC智控 WS：{"type":"list"} → data=["host:port",...]；Docker 用 host.docker.internal
# auto：有 ONIRENT_ADB 用固定端點；否則打 WS（ONIRENT 客戶端須開著）
ALIOTH_ONIRENT_ADB_SOURCE=auto
ALIOTH_ONIRENT_WS_URL=ws://127.0.0.1:33332/
ALIOTH_CLOUD_PHONE_ADB=51.89.167.239:20195
ALIOTH_CLOUD_PHONE_ADB_AUTH=
# 正式 App 质检设备池：槽位与 ONIRENT_ADB 等长（当前仅 ONIRENT）
ALIOTH_APP_DEVICE_LEASE_BACKEND=postgres
ALIOTH_DEVICE_POOL_SLOTS=cloud_phone:qa-a,cloud_phone:qa-b
ALIOTH_DEVICE_POOL_ONIRENT_ADB=51.89.167.239:20195,51.195.137.27:20086
# Lab 真机对账：默认 off；联调可设 M4→M5→M6→M7（勿与 AUTHORITY_M* 同开）
ALIOTH_APP_LAB_MILESTONE=off
# 刀 B：关闭前排空／Probe；仅 M6/M7 可开，默认 false
ALIOTH_APP_LAB_EXECUTES_PROBE=false
# MoreLogin 已停用：保持空，禁止再填 env_id（仅当临时 VENDOR=morelogin 调试时才配置）
ALIOTH_DEVICE_POOL_MORELOGIN_ENV_IDS=
ALIOTH_DEVICE_WAIT_MAX_SECONDS=600
ALIOTH_DEVICE_LEASE_RECOVERY_INTERVAL_SECONDS=5
ALIOTH_DEVICE_LEASE_RECOVERY_GRACE_SECONDS=60
ALIOTH_CLOUD_PHONE_MORELOGIN_API=adb
ALIOTH_MORELOGIN_CLOUDPHONE_ID=
ALIOTH_MORELOGIN_API_MODE=local
ALIOTH_MORELOGIN_OPEN_API=
ALIOTH_MORELOGIN_API_ID=
ALIOTH_MORELOGIN_API_KEY=
ALIOTH_MORELOGIN_LOCAL_API=
ALIOTH_MORELOGIN_ADB_AUTO_REFRESH=0
ALIOTH_MORELOGIN_ADB_AUTO_ENABLE=0
# ONIRENT 无 power API：必须关闭
ALIOTH_MORELOGIN_ADB_AUTO_POWER_ON=0
ALIOTH_MORELOGIN_ADB_AUTO_POWER_OFF=0
ALIOTH_MORELOGIN_POWER_ON_WAIT_SECONDS=180
ALIOTH_REDROID_ADB=127.0.0.1:5555
ALIOTH_MOBILE_DEMO_HOST_EXECUTOR=http://127.0.0.1:8765
ALIOTH_MOBILE_DEMO_REMOTE_SYNC=0
ALIOTH_MOBILE_DEMO_FORCE_LOCAL=1
ALIOTH_MOBILE_DEMO_AI_DRIVER=1
# 上傳 APK 時用 AI 選 untitled.py／untitled1.py（失敗回退檔名規則）；設 0 關閉
ALIOTH_MOBILE_DEMO_AI_SCRIPT_SELECT=1
# Airtest 脚本根需由宿主机或部署环境显式挂载，不再从 services/api/app 内置读取。
ALIOTH_APP_SCRIPT_ROOT=/opt/alioth/mobile-scripts/untitled.air

# App 会话网络代理（真 network_trace → 投影 har）。默认关；开后设备走 HTTP proxy，
# Capture 会落 network_trace + format=network_events 的 har。MITM 另开且永不存 body。
# ALIOTH_APP_NETWORK_PROXY_ENABLED=1
# ALIOTH_APP_NETWORK_PROXY_LISTEN_HOST=0.0.0.0
# ALIOTH_APP_NETWORK_PROXY_LISTEN_PORT=18888
# ALIOTH_APP_NETWORK_PROXY_ADVERTISE_HOST=10.0.2.2
# ALIOTH_APP_NETWORK_PROXY_DEVICE_HOST=
# ALIOTH_APP_NETWORK_PROXY_MITM_ENABLED=0
# ALIOTH_APP_NETWORK_PROXY_MITM_CA_DIR=

# 視覺 POC 建議 chat_completion
ALIOTH_LLM_API_STYLE=chat_completion
ALIOTH_LLM_MODEL=gpt-4o-mini
# ALIOTH_LLM_API_KEY=
# ALIOTH_LLM_BASE_URL=
