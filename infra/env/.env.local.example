ALIOTH_ENV_FILE=./env/.env.local.example
ALIOTH_ENVIRONMENT=local
ALIOTH_DEBUG=true
ALIOTH_API_V1_PREFIX=/api/v1

ALIOTH_API_PORT=8000
ALIOTH_API_BIND_HOST=127.0.0.1
ALIOTH_WEB_PORT=5173
ALIOTH_DEVUI_PORT=8080
ALIOTH_POSTGRES_PORT=5432
ALIOTH_REDIS_PORT=6379
ALIOTH_WEB_APP_DIR=app/workstation

POSTGRES_DB=alioth
POSTGRES_USER=alioth
POSTGRES_PASSWORD=alioth-local-password

ALIOTH_DATABASE_URL=postgresql+asyncpg://alioth:alioth-local-password@alioth-postgres:5432/alioth
ALIOTH_REDIS_URL=redis://alioth-redis:6379/0
ALIOTH_AGENT_RUN_QUEUE_KEY=alioth:agent-runs:queue
ALIOTH_WEB_AGENT_RUN_QUEUE_KEY=alioth:web-agent-runs:queue
ALIOTH_WEB_WORKER_CONCURRENCY=1
# H5 视觉坐标导航：off 完全关闭；shadow 仅审计；enforced 仅执行受信白名单能力。
ALIOTH_H5_VISUAL_COORDINATE_MODE=off
# H5 浏览器代理默认关闭；Docker 需要代理时显式填写容器可达地址。
ALIOTH_H5_BROWSER_PROXY_SERVER=
ALIOTH_H5_BROWSER_PROXY_BYPASS=
# Web V2 桌面浏览器代理默认关闭；与 H5 独立配置。
ALIOTH_WEB_BROWSER_PROXY_SERVER=
ALIOTH_WEB_BROWSER_PROXY_BYPASS=
# Web V2 专用运行器默认关闭。仅探索使用 exploration_only，并启用 web_explorer；
# 完整规则质检使用 on，并同时启用 web_explorer、judge。
ALIOTH_WEB_V2_MODE=off
VITE_API_BASE_URL=http://localhost:8000/api/v1

# workstation 开发代理目标：容器内指向 alioth-api；宿主机跑 npm run dev 时无需设置（默认 localhost:8000）。
ALIOTH_WEB_API_PROXY_TARGET=http://alioth-api:8000

ALIOTH_DEVUI_API_BASE_URL=http://alioth-api:8000/api/v1
DEVUI_AUTH_TOKEN=change-me-local-only

# 本地开发默认启用优化质检流水线；生产环境仍按影子门禁逐步放量。
ALIOTH_QC_OPTIMIZED_PIPELINE_MODE=on
ALIOTH_QC_VERDICT_MODE=balanced
ALIOTH_QC_SHADOW_SAMPLE_RATE=0.10
ALIOTH_QC_PROMPT_INPUT_TOKEN_BUDGET=80000
ALIOTH_QC_SEMANTIC_BATCH_SIZE=4
ALIOTH_QC_SEMANTIC_CONCURRENCY=2
ALIOTH_QC_SEMANTIC_BATCH_TIMEOUT_SECONDS=90
ALIOTH_QC_PAGE_DETECTION_TIMEOUT_SECONDS=90
ALIOTH_QC_PAGE_CAPTURE_TIMEOUT_SECONDS=300
ALIOTH_QC_WEB_INTERACTION_TIMEOUT_SECONDS=120
ALIOTH_QC_PAGE_CAPTURE_CONCURRENCY=1
ALIOTH_QC_SCROLL_MAX_SEGMENTS=8

# 持久化质检工作项控制面独立灰度，避免与判定优化开关耦合。
ALIOTH_QC_INSPECTION_LEASE_SECONDS=180
ALIOTH_QC_INSPECTION_MAX_ATTEMPTS=3
ALIOTH_QC_INSPECTION_RETRY_BASE_SECONDS=2

# App 设备租约：正式链跨 Worker 互斥以 PostgreSQL 为事实源。
ALIOTH_APP_DEVICE_LEASE_BACKEND=postgres
ALIOTH_CLOUD_PHONE_VENDOR=onirent
# tunnel=代码直连跳板 172.104.172.119:3xxxx（见 .env.linode-shared-tunnel.example）
# 槽位：qa-a=20615／qa-b=20660／qa-c=20907／qa-d=20033／qa-e=20613
ALIOTH_ONIRENT_ADB_SOURCE=tunnel
ALIOTH_ONIRENT_ADB_TUNNEL=1
ALIOTH_ONIRENT_ADB_TUNNEL_JUMP_HOST=172.104.172.119
ALIOTH_ONIRENT_WS_URL=ws://127.0.0.1:33332/
ALIOTH_DEVICE_POOL_SLOTS=cloud_phone:qa-a,cloud_phone:qa-b,cloud_phone:qa-c,cloud_phone:qa-d,cloud_phone:qa-e
ALIOTH_DEVICE_POOL_ONIRENT_ADB=172.104.172.119:30615,172.104.172.119:30660,172.104.172.119:30907,172.104.172.119:30033,172.104.172.119:30613
ALIOTH_CLOUD_PHONE_ADB=172.104.172.119:30615
ALIOTH_CLOUD_PHONE_MORELOGIN_API=adb
# App Lab 真机对账组合根（默认 off；勿与 ALIOTH_APP_MILESTONE_AUTHORITY_M* 同时开）
# off | M4(Broker actions) | M5(+图调度) | M6(+补采 runtime_ready 声明) | M7(+Gate 裁决预览)
ALIOTH_APP_LAB_MILESTONE=off
# 刀 B：关闭前排空／Probe；仅 M6/M7 可开，默认 false
ALIOTH_APP_LAB_EXECUTES_PROBE=false
# MoreLogin 已停用：保持空；勿再填 env_id／Local API
ALIOTH_DEVICE_POOL_MORELOGIN_ENV_IDS=
ALIOTH_DEVICE_WAIT_MAX_SECONDS=600
ALIOTH_MORELOGIN_CLOUDPHONE_ID=
ALIOTH_MORELOGIN_API_MODE=local
ALIOTH_MORELOGIN_OPEN_API=
ALIOTH_MORELOGIN_API_ID=
ALIOTH_MORELOGIN_API_KEY=
ALIOTH_MORELOGIN_LOCAL_API=
ALIOTH_MORELOGIN_ADB_AUTO_REFRESH=0
ALIOTH_MORELOGIN_ADB_AUTO_ENABLE=0
ALIOTH_MORELOGIN_ADB_AUTO_POWER_ON=0
ALIOTH_MORELOGIN_ADB_AUTO_POWER_OFF=0
ALIOTH_DEVICE_LEASE_RECOVERY_INTERVAL_SECONDS=5
ALIOTH_DEVICE_LEASE_RECOVERY_GRACE_SECONDS=60

# 证据清单读取 / 离场门禁 / 生命周期（本地默认安全关闭）
ALIOTH_EVIDENCE_MANIFEST_READ_MODE=off
ALIOTH_EVIDENCE_MANIFEST_MIN_COMPARED_CAPTURES=1
ALIOTH_WEB_EVIDENCE_EXIT_GATE_MODE=off
ALIOTH_EVIDENCE_LIFECYCLE_POLICY_VERSION=evidence-lifecycle.v1
ALIOTH_EVIDENCE_RETENTION_DAYS=90
ALIOTH_EVIDENCE_GC_ENABLED=false
ALIOTH_EVIDENCE_GC_BATCH_LIMIT=100
