    "surface_kinds": ["web", "android", "ios"],
    "extensions": {
      "rule_codes": ["alioth_45"],
      "stop_before": "confirm_publish"
    },
    "steps": [
      {
        "id": "enter-publish",
        "type": "action",
        "operation": "tap",
        "semantic_target": "发布入口"
      },
      {
        "id": "wait-publish-page",
        "type": "wait",
        "condition": "surface_stable",
        "duration_ms": 2000
      },
      {
        "id": "capture-upload-limit",
        "type": "capture",
