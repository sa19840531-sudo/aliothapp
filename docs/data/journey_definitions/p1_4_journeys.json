  {
    "schema_version": "journey-dsl.v1",
    "definition_id": "ad-outbound-landing-return",
    "version": 1,
    "name": "广告落地：素材→点击→落地→返回",
    "description": "覆盖 alioth_17。App 已有 ad_outbound_source／landing／return。验收需重复约 10 次找素材与落地不同步证据。",
    "surface_kinds": ["web", "android", "ios"],
    "extensions": {
      "rule_codes": ["alioth_17"],
      "app_capture_roles": [
        "ad_outbound_source",
        "ad_outbound_landing",
        "ad_outbound_return"
      ],
      "verification_repeats": 10,
      "verification_note": "重复执行约 10 次，找素材与落地页未形成同步动作对的证据"
    },
    "steps": [
      {
        "id": "capture-ad-source",
        "type": "capture",
        "role": "ad_outbound_source",
        "artifact_types": ["screenshot", "ui_snapshot"],
        "reason": "开屏／插屏广告素材帧"
      },
      {
        "id": "click-ad",
        "type": "action",
        "operation": "tap",
        "semantic_target": "广告素材可点区域"
      },
      {
        "id": "wait-landing",
        "type": "wait",
        "condition": "surface_stable",
        "duration_ms": 4000
      },
      {
        "id": "capture-landing",
        "type": "capture",
        "role": "ad_outbound_landing",
        "artifact_types": ["screenshot", "action_trace"],
        "reason": "广告落地页"
      },
      {
        "id": "return-from-landing",
        "type": "action",
        "operation": "back"
      },
      {
        "id": "capture-return",
        "type": "capture",
        "role": "ad_outbound_return",
        "artifact_types": ["screenshot", "action_trace"],
        "reason": "从落地返回业务页"
      }
    ]
  },
  {
    "schema_version": "journey-dsl.v1",
