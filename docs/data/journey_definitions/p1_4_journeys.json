[
  {
    "schema_version": "journey-dsl.v1",
    "definition_id": "player-playback-seek-episode",
    "version": 1,
    "name": "播放器：进播→控件截帧→seek→切集→退出再进",
    "description": "覆盖 alioth_44 进度条、ops_3 播放、ops_9 切集、alioth_43 退出再进。多帧观察用 wait+capture 代替 timed_capture 动作动词。",
    "surface_kinds": ["web", "android", "ios"],
    "extensions": {
      "rule_codes": ["alioth_44", "alioth_ops_3", "alioth_ops_9", "alioth_43"],
      "app_har_fallback": "screenshot",
      "notes": "App 缺 HAR 时用截图；播放控件唤醒后采一帧进度。"
    },
    "steps": [
      {
        "id": "enter-player",
        "type": "action",
        "operation": "tap",
        "semantic_target": "内容播放入口",
        "retry": {"max_attempts": 2, "backoff_ms": 500, "retry_on": ["target_not_found"]}
      },
      {
        "id": "wait-player-stable",
        "type": "wait",
        "condition": "surface_stable",
        "duration_ms": 3000
      },
      {
        "id": "wake-controls",
        "type": "action",
        "operation": "tap",
        "semantic_target": "播放器画面中心",
        "required": false
      },
      {
        "id": "capture-progress-frame",
        "type": "capture",
        "role": "player_scrub_series",
        "artifact_types": ["screenshot", "ui_snapshot", "media_state"],
        "reason": "alioth_44／ops_3：控件唤醒后采进度条与播放态一帧"
      },
      {
        "id": "seek-media",
        "type": "action",
        "operation": "seek_media",
        "arguments": {"purpose": "拖动播放进度条采集进度证据"}
      },
      {
        "id": "capture-after-seek",
        "type": "capture",
        "role": "post_action",
        "artifact_types": ["screenshot", "media_state", "action_trace"],
        "reason": "seek 后留证"
      },
      {
        "id": "switch-episode",
        "type": "action",
        "operation": "tap",
        "semantic_target": "第2集",
        "retry": {"max_attempts": 2, "backoff_ms": 500, "retry_on": ["target_not_found"]}
      },
      {
        "id": "wait-episode-switch",
        "type": "wait",
        "condition": "surface_stable",
        "duration_ms": 3000
      },
      {
        "id": "capture-episode-2",
        "type": "capture",
        "role": "post_action",
        "artifact_types": ["screenshot", "media_state", "action_trace"],
        "reason": "ops_9：切集后确认集数变化"
      },
      {
        "id": "assert-episode-visible",
        "type": "assert",
        "assertion": "element_visible",
        "semantic_target": "第2集",
        "evidence_keys": ["screenshot", "ui_snapshot"]
      },
      {
        "id": "exit-player",
        "type": "action",
        "operation": "back"
      },
      {
        "id": "wait-after-exit",
        "type": "wait",
        "condition": "surface_stable",
        "duration_ms": 2000
      },
      {
        "id": "reenter-player",
        "type": "action",
        "operation": "tap",
        "semantic_target": "内容播放入口"
      },
      {
        "id": "capture-reenter",
        "type": "capture",
        "role": "post_action",
        "artifact_types": ["screenshot", "media_state"],
        "reason": "alioth_43：退出再进播放页"
      }
    ]
  },
  {
    "schema_version": "journey-dsl.v1",
    "definition_id": "payment-checkout-chain",
    "version": 1,
    "name": "支付链：进档→选档→拉起支付→收银台／外跳金额",
    "description": "覆盖 ops_4 进支付、ops_5 拉起支付、ops_11 收银台／外跳金额。自动化不点确认付款。App 用 checkout_chain_step；Web 扫码页即收银台。",
    "surface_kinds": ["web", "android", "ios"],
    "extensions": {
      "rule_codes": ["alioth_ops_4", "alioth_ops_5", "alioth_ops_11"],
      "app_capture_roles": ["checkout_chain_step"],
      "web_cashier_note": "Web 多为扫码，落地页即收银台",
      "app_har_fallback": "screenshot",
      "stop_before": "confirm_pay"
    },
    "steps": [
      {
        "id": "enter-payment",
        "type": "action",
        "operation": "tap",
        "semantic_target": "开通会员入口"
      },
      {
        "id": "wait-tier-list",
        "type": "wait",
        "condition": "element_visible",
        "semantic_target": "会员档位列表"
      },
      {
        "id": "capture-tier-list",
        "type": "capture",
        "role": "checkout_chain_step",
        "artifact_types": ["screenshot", "ui_snapshot"],
        "reason": "ops_4：进支付／档位页；App step_key=cart_or_sku"
      },
      {
        "id": "select-tier",
        "type": "action",
        "operation": "tap",
        "semantic_target": "会员档位"
      },
      {
        "id": "capture-confirm-order",
        "type": "capture",
        "role": "checkout_chain_step",
        "artifact_types": ["screenshot"],
        "reason": "选档后确认页；App step_key=confirm_order"
      },
      {
        "id": "trigger-pay",
        "type": "action",
        "operation": "tap",
        "semantic_target": "立即支付"
      },
      {
        "id": "wait-cashier",
        "type": "wait",
        "condition": "surface_stable",
        "duration_ms": 4000
      },
      {
        "id": "capture-cashier",
        "type": "capture",
        "role": "checkout_chain_step",
        "artifact_types": ["screenshot", "action_trace"],
        "reason": "ops_11：收银台或外跳支付金额截图；App step_key=in_app_cashier；缺 HAR 用截图"
      },
      {
        "id": "assert-amount-visible",
        "type": "assert",
        "assertion": "element_visible",
        "semantic_target": "支付金额",
        "evidence_keys": ["screenshot"]
      }
    ]
  },
  {
    "schema_version": "journey-dsl.v1",
    "definition_id": "comment-post-and-refresh",
    "version": 1,
    "name": "评论：定位区→发评→采首评→刷新",
    "description": "覆盖 alioth_31 发评后刷新可见。",
    "surface_kinds": ["web", "android", "ios"],
    "extensions": {
      "rule_codes": ["alioth_31"],
      "app_har_fallback": "screenshot"
    },
    "steps": [
      {
        "id": "open-comment-area",
        "type": "action",
        "operation": "tap",
        "semantic_target": "评论入口"
      },
      {
        "id": "wait-comment-box",
        "type": "wait",
        "condition": "element_visible",
        "semantic_target": "评论输入框"
      },
      {
        "id": "input-comment",
        "type": "action",
        "operation": "input",
        "semantic_target": "评论输入框",
        "arguments": {"text": "质检评论样本"}
      },
      {
        "id": "submit-comment",
        "type": "action",
        "operation": "tap",
        "semantic_target": "发送评论"
      },
      {
        "id": "capture-primary-comment",
        "type": "capture",
        "role": "post_action",
        "artifact_types": ["screenshot", "ui_snapshot"],
        "reason": "采主评／首评"
      },
      {
        "id": "refresh-comments",
        "type": "action",
        "operation": "refresh"
      },
      {
        "id": "capture-after-refresh",
        "type": "capture",
        "role": "post_action",
        "artifact_types": ["screenshot"],
        "reason": "刷新后确认评论仍可见"
      },
      {
        "id": "assert-comment-visible",
        "type": "assert",
        "assertion": "element_visible",
        "semantic_target": "质检评论样本",
        "evidence_keys": ["screenshot", "ui_snapshot"]
      }
    ]
  },
  {
