# 青云（aliothdev1.5）本机联调星语 Official 的环境片段
# 复制到青云进程环境或 .env.local；Token 必须与星语 ALIOTH_XINGYU_OFFICIAL_TOKEN 一致。
#
# 星语侧先启动（示例）：
#   ALIOTH_XINGYU_OFFICIAL_ENABLED=1
#   ALIOTH_XINGYU_OFFICIAL_TOKEN=xingyu-local-dev-token
#   ALIOTH_XINGYU_BUILD_CACHE=F:\aliothapp\.alioth-xingyu-builds
#   # 真机勿开 DRY_RUN；无真机契约壳可用 DRY_RUN=1
#
# 合同测试（不写 PG）：
#   先用 scripts/stage-xingyu-apk.ps1 落入 cache，再填下方 CONTRACT_* 三项。

ALIOTH_APP_QC_ENABLED=true
ALIOTH_APP_RUNTIME_PROVIDER=official
# auto：official 默认走 LLM Vision；本机 fake 仍可用 ALIOTH_APP_VISION_PROVIDER=llm 联调库存
ALIOTH_APP_VISION_PROVIDER=auto
ALIOTH_OFFICIAL_APP_API_BASE_URL=http://127.0.0.1:8020
ALIOTH_OFFICIAL_APP_AUTH_HEADER_NAME=Authorization
ALIOTH_OFFICIAL_APP_AUTH_TOKEN=xingyu-local-dev-token
ALIOTH_OFFICIAL_APP_TIMEOUT_SECONDS=120
# Capture／UI Tree 专用超时：须盖住云手机 pull+refresh（默认／下限 180）
ALIOTH_OFFICIAL_APP_CAPTURE_TIMEOUT_SECONDS=180
ALIOTH_OFFICIAL_APP_MAX_SCREENSHOT_BYTES=20971520

# 星语侧（同一进程也可）Swagger：http://127.0.0.1:8020/v1/api-doc
# ALIOTH_XINGYU_OFFICIAL_ENABLED=1
# ALIOTH_XINGYU_OFFICIAL_TOKEN=xingyu-local-dev-token

# LLM（Screenshot Understanding / Explorer 共用）
# ALIOTH_LLM_API_KEY=...
# ALIOTH_LLM_MODEL=gpt-4o-mini
# ALIOTH_LLM_BASE_URL=...

# 真实星语合同闸门（缺任一则 pytest skip）
ALIOTH_OFFICIAL_APP_CONTRACT_TEST_ENABLED=true
ALIOTH_OFFICIAL_APP_CONTRACT_PLATFORM_BUILD_REF=app-build:00000000-0000-0000-0000-000000000001
ALIOTH_OFFICIAL_APP_CONTRACT_PACKAGE_NAME=com.example.contract
ALIOTH_OFFICIAL_APP_CONTRACT_APK_SHA256=replace_with_staged_sha256
