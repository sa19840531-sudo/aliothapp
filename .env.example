# Alioth 平台环境变量示例文件。
# 使用方式：复制为 .env 作为默认本地配置；也可以复制为 .env.local 保存个人覆盖项。
# 加载优先级：进程环境变量 > .env.local > .env > 代码默认值。
# .env 与 .env.local 均已被 .gitignore 排除，不会提交真实凭证到版本库。
# Compose 从隔离 worktree 启动时，可显式指向主工作区的本机覆盖文件；默认行为不变。
ALIOTH_LOCAL_OVERRIDE_ENV_FILE=../.env.local

# ==========================================================
# 基础服务配置
# ==========================================================
ALIOTH_APP_NAME=Alioth API
ALIOTH_ENVIRONMENT=local
ALIOTH_API_V1_PREFIX=/api/v1
ALIOTH_DEBUG=false

# ==========================================================
# 数据库配置（migrations / 后续持久化存储）
# ==========================================================
ALIOTH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/alioth

# 页面采集证据存储后端：local | minio。
ALIOTH_EVIDENCE_STORAGE_BACKEND=local
# local 模式的证据文件根目录；数据库保存相对路径与校验信息。
ALIOTH_EVIDENCE_STORAGE_ROOT=.alioth/evidence
# minio 模式配置。Endpoint 使用 S3 API 端口，不是管理控制台端口。
ALIOTH_MINIO_ENDPOINT=HOST:9000
ALIOTH_MINIO_ACCESS_KEY=
ALIOTH_MINIO_SECRET_KEY=
ALIOTH_MINIO_BUCKET=alioth
ALIOTH_MINIO_SECURE=false

# 登录 JWT 的 HS256 签名密钥；生产/测试环境必须显式配置为强随机值（各实例一致），
# 未配置时使用开发兜底密钥并打告警日志。
ALIOTH_AUTH_SECRET=

# ==========================================================
# 大模型网关配置（infrastructure/llm_gateway）
# ==========================================================
# provider: openai | azure_openai | xai | custom
#   - openai / azure_openai：官方 SDK 原生支持。
#   - xai / custom：均视为"OpenAI 兼容"端点，必须显式提供 ALIOTH_LLM_BASE_URL。
ALIOTH_LLM_PROVIDER=openai

# api_style: responses | chat_completion
#   - responses：OpenAI / Azure OpenAI 推荐使用的新一代 Responses API。
#   - chat_completion：传统 Chat Completions API，用于 x.ai / DeepSeek 等尚未支持 Responses API 的供应商。
ALIOTH_LLM_API_STYLE=responses

ALIOTH_LLM_MODEL=gpt-4o-mini
ALIOTH_LLM_API_KEY=
ALIOTH_LLM_BASE_URL=
# 可选：none | low | medium | high；仅对供应商支持的模型生效。
ALIOTH_LLM_REASONING_EFFORT=

# 仅 provider=azure_openai 时需要填写：
ALIOTH_LLM_AZURE_ENDPOINT=
ALIOTH_LLM_AZURE_API_VERSION=

ALIOTH_LLM_TIMEOUT_SECONDS=180
ALIOTH_LLM_MAX_RETRIES=2
# LLM 成本统计配置；单价按每 100 万 tokens 配置。
# grok-4.5 / Routin 当前人民币阶梯：0-200K input/cache/output = 0.8/0.2/2.4，
# >=200K input/cache/output = 1.6/0.4/4.8。
ALIOTH_LLM_USAGE_AUDIT_ENABLED=1
ALIOTH_LLM_COST_CURRENCY=CNY
ALIOTH_LLM_INPUT_PRICE_PER_MILLION_TOKENS=0.8
ALIOTH_LLM_OUTPUT_PRICE_PER_MILLION_TOKENS=2.4
ALIOTH_LLM_CACHE_HIT_PRICE_PER_MILLION_TOKENS=0.2
ALIOTH_LLM_LONG_CONTEXT_THRESHOLD_TOKENS=200000
ALIOTH_LLM_LONG_CONTEXT_INPUT_PRICE_PER_MILLION_TOKENS=1.6
ALIOTH_LLM_LONG_CONTEXT_OUTPUT_PRICE_PER_MILLION_TOKENS=4.8
ALIOTH_LLM_LONG_CONTEXT_CACHE_HIT_PRICE_PER_MILLION_TOKENS=0.4

# DeepSeek 本地覆盖示例（建议放入 .env.local，不要写入真实密钥到 .env.example）：
# ALIOTH_LLM_PROVIDER=custom
# ALIOTH_LLM_API_STYLE=chat_completion
# ALIOTH_LLM_MODEL=deepseek-v4-flash
# ALIOTH_LLM_API_KEY=你的_DeepSeek_API_Key
# ALIOTH_LLM_BASE_URL=https://api.deepseek.com

# ==========================================================
# Agent 核心运行护栏配置（agents/runtime）
# ==========================================================
# 单次 Agent Run 的基础工具步数预算；动态页面模式可扩展，但不会突破下方系统硬上限。
ALIOTH_AGENT_MAX_STEPS=200
# 传递给 Agent Framework function_invocation_configuration 的最大大模型往返轮次（框架自带的尽力而为防护）。
ALIOTH_AGENT_MAX_ITERATIONS=200
# 单次 Agent Run 允许的最长墙钟时间（秒），超时由编排层 asyncio.wait_for 强制中断。
ALIOTH_AGENT_MAX_DURATION_SECONDS=3600
# 判定"卡死/无进展"所需的连续相同调用（工具名+参数完全一致）次数。
ALIOTH_AGENT_STUCK_WINDOW=3
# 单次工具调用尝试允许的最大总次数（含首次尝试），由 RetryMiddleware 强制执行。
ALIOTH_AGENT_RETRY_MAX_ATTEMPTS=3
# RetryMiddleware 相邻两次重试之间的固定退避等待时间（秒）。
ALIOTH_AGENT_RETRY_BACKOFF_SECONDS=0.5
# 模型提前返回但页面 Frontier 尚未收敛时，允许复用同一会话续跑的次数。
ALIOTH_AGENT_MAX_CONTINUATION_ATTEMPTS=3
# 连续基础设施故障达到该阈值后停止无效重试，并把剩余页面工作转人工复核。
ALIOTH_AGENT_MAX_CONSECUTIVE_INFRA_FAILURES=3
# 页面数量运行前未知时，是否按已形成首采的逻辑页面动态扩展工具步数预算。
ALIOTH_AGENT_ADAPTIVE_PAGE_BUDGET=true
# 动态预算不可突破的系统硬上限。
ALIOTH_AGENT_MAX_STEPS_HARD_CAP=600
# 动态页面预算的基础步数，以及每个逻辑页面追加的步数。
ALIOTH_AGENT_PAGE_BUDGET_BASE_STEPS=12
ALIOTH_AGENT_PAGE_BUDGET_STEPS_PER_PAGE=16

# ==========================================================
# 质检优化流水线配置（重启 Worker 后仅影响新领取任务）
# ==========================================================
# off：旧流程；shadow：候选流程影子比对；on：启用候选流程。
ALIOTH_QC_OPTIMIZED_PIPELINE_MODE=off
ALIOTH_QC_SHADOW_SAMPLE_RATE=0.10
# 模型文本输入硬上限，内部会为图片与输出预留空间。
ALIOTH_QC_PROMPT_INPUT_TOKEN_BUDGET=80000
ALIOTH_QC_SEMANTIC_BATCH_SIZE=4
ALIOTH_QC_SEMANTIC_CONCURRENCY=2
# 单个语义批次（含批量失败后的单条降级）的总墙钟预算。
ALIOTH_QC_SEMANTIC_BATCH_TIMEOUT_SECONDS=90
# 单次页面识别（含确定性回退）的总墙钟预算。
ALIOTH_QC_PAGE_DETECTION_TIMEOUT_SECONDS=90
ALIOTH_QC_PAGE_CAPTURE_TIMEOUT_SECONDS=300
ALIOTH_QC_WEB_INTERACTION_TIMEOUT_SECONDS=120
ALIOTH_QC_PAGE_CAPTURE_CONCURRENCY=1
# 语义规则判定独立墙钟预算；覆盖结构修正与批次拆单，避免继承通用模型的长重试链。
ALIOTH_QC_SEMANTIC_REQUEST_TIMEOUT_SECONDS=60
ALIOTH_QC_SEMANTIC_MAX_RETRIES=0
# 同一任务确认线路故障后短时熔断，其他并发任务不共享该状态。
ALIOTH_QC_SEMANTIC_CIRCUIT_SECONDS=120
ALIOTH_QC_SCROLL_MAX_SEGMENTS=8
# Inspection Redis wakeup 仅提交 task/run 身份；Judge worker 从 PostgreSQL 有界领取。
ALIOTH_QC_INSPECTION_JUDGE_CONCURRENCY=2
ALIOTH_QC_INSPECTION_DISPATCH_BATCH_LIMIT=1
ALIOTH_QC_INSPECTION_PUBLICATION_BATCH_LIMIT=1
ALIOTH_QC_INSPECTION_PUBLICATION_TIMEOUT_SECONDS=30
ALIOTH_QC_INSPECTION_DISPATCH_QUEUE_CAPACITY=128

# ==========================================================
# 补采/补证能力开关（服务端统一门禁）
# ==========================================================
# 默认关闭；H5 V2 正式模式可显式开启，关闭时只记录证据不足，不执行 Probe 补采。
# App/Web 仍按各自运行时就绪合同控制，不会因 H5 开启而放行。
ALIOTH_SUPPLEMENTAL_EVIDENCE_ENABLED=false

# ==========================================================
# H5 主动登录配置（仅 H5 V2，默认关闭）
# ==========================================================
# 配置文件保存低权限测试账号；生产环境应限制文件读取权限，不要在本文件写入凭证。
# JSON 配置按精确 hostname 覆盖 global，禁止通配符和跨 hostname 使用。
ALIOTH_H5_AUTH_ENABLED=false
ALIOTH_H5_AUTH_CONFIG_PATH=
ALIOTH_H5_INSPECTION_NOTIFICATION_MODE=off
# H5 视觉坐标导航：off 完全关闭；shadow 仅审计；enforced 仅执行受信白名单能力。
# 默认 off，普通 H5、DOM SPA 与 Semantics 充足页面保持原流程。
ALIOTH_H5_VISUAL_COORDINATE_MODE=off
# H5 Chromium 出网代理；默认留空保持直连。代理 URL 禁止携带凭据或路径。
ALIOTH_H5_BROWSER_PROXY_SERVER=
# Playwright 逗号分隔旁路列表；仅在 SERVER 非空时生效。
ALIOTH_H5_BROWSER_PROXY_BYPASS=
# Web V2 桌面 Chromium 出网代理；与 H5 独立，默认留空保持直连。
ALIOTH_WEB_BROWSER_PROXY_SERVER=
ALIOTH_WEB_BROWSER_PROXY_BYPASS=
# CLI 与 Python 采集共用页面：off 保持原行为，observe 只读对比，actions 开放受控操作。
ALIOTH_H5_CLI_MODE=off
# 本地安装与必要兼容补丁见 docs/design/2026-09-06-playwright-cli-runtime.md；镜像已内置。
# 镜像运行时不要用本地路径覆盖 Dockerfile 中的 ALIOTH_PLAYWRIGHT_CLI_SCRIPT。
# ALIOTH_PLAYWRIGHT_CLI_SCRIPT=infra/playwright-cli/node_modules/@playwright/cli/playwright-cli.js
ALIOTH_PLAYWRIGHT_CLI_WORKSPACE_ROOT=/tmp/alioth-playwright-cli

# ==========================================================
# Redis 任务队列配置（infrastructure/queue）
# ==========================================================
ALIOTH_REDIS_URL=redis://localhost:6379/0
# 原有 H5/App/通用探索等待队列；保持既有默认值。
ALIOTH_AGENT_RUN_QUEUE_KEY=alioth:agent-runs:queue
# Web V2 独立等待队列；禁止与原有队列配置为同一个 key。
ALIOTH_WEB_AGENT_RUN_QUEUE_KEY=alioth:agent-runs:web-v2
# Agent Run 记录在 Redis 中的存活时间（秒），默认 24 小时；仅用于短期查询，不是长期审计存储。
ALIOTH_QUEUE_RUN_TTL_SECONDS=86400
# Agent Run 长期状态写入后端：noop | postgres。默认 noop，业务任务链路接入 task_id 后再开启 postgres。
ALIOTH_AGENT_RUN_STATE_STORE_BACKEND=noop

# ==========================================================
# 后台 Worker 进程配置（services/api/app/worker.py）
# ==========================================================
# 单个 Worker 进程内并发消费任务的协程数量。
ALIOTH_WORKER_CONCURRENCY=3
# Web-only Worker 的独立并发度，首期固定建议为 1。
ALIOTH_WEB_WORKER_CONCURRENCY=1
# explorer,judge 为原有角色；Web-only 部署单独设置为 web_explorer。
ALIOTH_WORKER_ROLES=explorer,judge
# 每次向 Redis 队列阻塞式取任务的超时时间（秒）。
ALIOTH_WORKER_POLL_TIMEOUT_SECONDS=5

# ==========================================================
# App 设备租约（排期第 55 行：跨 Worker 互斥以 PostgreSQL 为事实源）
# ==========================================================
# Fake/本地无 PG 池可保持 in_process；启用正式 App 质检时必须 postgres。
ALIOTH_APP_DEVICE_LEASE_BACKEND=in_process
# 库存槽位，形如 backend:profile；生产至少登记一台 cloud_phone。
ALIOTH_DEVICE_POOL_SLOTS=cloud_phone:qa-a,cloud_phone:qa-b,cloud_phone:qa-c,cloud_phone:qa-d,cloud_phone:qa-e,cloud_phone:qa-f,cloud_phone:qa-g,cloud_phone:qa-h,cloud_phone:qa-i,cloud_phone:qa-j
# 与 cloud_phone 槽位等长的 MoreLogin envId；qa-a=CP-1、qa-b=CP-2、qa-c=CP-3。多机禁止只配全域 CLOUDPHONE_ID。
ALIOTH_DEVICE_POOL_MORELOGIN_ENV_IDS=1716966721435348,1721996810228932,1721996906474529,1721996994554962,1721997076343965,1721997164647887,1721997246436876,1721997328225844,1721997416082920,1721997510454870
# 池满有界等待上限（秒）；0 关闭等待。Worker concurrency 建议不超过 cloud_phone 槽位数。
ALIOTH_DEVICE_WAIT_MAX_SECONDS=600
# 同事本机共用云手机：复制 infra/env/.env.teammate-cloud-phone.example。
# MoreLogin Open API（无需安装客户端）：设置 ID/Key 后走 https://api.morelogin.com。
ALIOTH_DEVICE_BACKEND=cloud_phone
ALIOTH_MORELOGIN_API_MODE=auto
ALIOTH_MORELOGIN_OPEN_API=https://api.morelogin.com
ALIOTH_MORELOGIN_API_ID=1716959676829288
ALIOTH_MORELOGIN_API_KEY=
ALIOTH_MORELOGIN_ADB_AUTO_REFRESH=1
ALIOTH_MORELOGIN_ADB_AUTO_ENABLE=1
ALIOTH_MORELOGIN_ADB_AUTO_POWER_ON=1
# App 质检释放／隔离租约后：关闭本台 + 池内全部空闲云手机（默认开；测试频繁开关机设 0）
# 覆盖 ALIOTH_DEVICE_POOL_MORELOGIN_ENV_IDS 映射的 qa-a～qa-j；并发占用中的机器会跳过。
# 开启时若仍有排队／待领设备的 App 任务，会跳过关机以便连跑；无后续任务才关机。
ALIOTH_MORELOGIN_ADB_AUTO_POWER_OFF=1
# 公网 ADB 会逐个拉取其他已安装 APK 比对同显示名降版风险；默认开启。
# 设为 0 时仍须任务备注包含 SAME_LABEL_SCAN_SKIP_AUTHORIZED（或「授权跳过同名降版扫描」），
# 报告会写入 task.same_label_risk_acceptance；仅关环境变量无效。
ALIOTH_CLOUD_PHONE_SAME_LABEL_SCAN_ENABLED=1
# Airtest 历史脚本不随 API 包内置；需要 Airtest 路由时显式挂载外部脚本根。
# 目录结构示例：/opt/alioth/mobile-scripts/untitled.air/untitled.py、
# /opt/alioth/mobile-scripts/untitled.air/untitled1.air/untitled1.py。
ALIOTH_APP_SCRIPT_ROOT=/opt/alioth/mobile-scripts/untitled.air
# 过期租约回收间隔与非终态 Session 隔离宽限期。
ALIOTH_DEVICE_LEASE_RECOVERY_INTERVAL_SECONDS=5
ALIOTH_DEVICE_LEASE_RECOVERY_GRACE_SECONDS=60
# Web 成年自我声明：配置级生效，不按账号、会话或站点重复确认。
ALIOTH_WEB_ADULT_SELF_ATTESTATION_ENABLED=false
ALIOTH_WEB_ADULT_SELF_ATTESTATION_VERSION=adult-v1
ALIOTH_WEB_ADULT_SELF_ATTESTATION_DECLARED_BY=
ALIOTH_WEB_ADULT_SELF_ATTESTATION_DECLARED_AT=
